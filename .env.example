# gastito — copy to .env and fill in. The same secret must match where noted.

# --- Postgres ---
POSTGRES_USER=gastito
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=gastito

# --- web (spliit) ---
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=USD
# Shared bearer guarding /api/bot/* — must match the bot's BOT_INGEST_SECRET below.
BOT_INGEST_SECRET=change-me-ingest-secret
# Shared login for the web UI (Basic Auth) — one user/pass for the whole group.
# Leave both empty to skip the login prompt (e.g. local dev).
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASS=

# --- bot (LLM: dos slots OpenAI-compatibles en orden, después Gemini) ---
# GitHub Models era el primario; se retiró el 2026-07-30 (su endpoint responde 410).
# Cualquier proveedor con API OpenAI-compatible entra acá sin tocar código: Groq,
# OpenAI, OpenRouter, Cerebras... El slot secundario es opcional: sin token, se saltea.
LLM_PRIMARY_TOKEN=gsk_...
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_SECONDARY_TOKEN=
LLM_SECONDARY_BASE_URL=https://api.openai.com/v1
LLM_SECONDARY_MODEL=gpt-4o-mini
# OBLIGATORIA para las notas de voz 🎙️ (además de ser el fallback del parseo).
# La transcripción es Gemini-only: gpt-4o-mini no escucha, así que acá NO hay
# proveedor de respaldo. Sin esta key el bot avisa que no puede escuchar audios.
GEMINI_API_KEY=
# `gemini-flash-latest` y no `gemini-2.0-flash`: en nuestro proyecto de Google el
# 2.0 devuelve 429 con `limit: 0` (el proyecto no tiene free tier para ese modelo),
# así que el fallback del parseo venía roto en silencio y los audios no andarían.
# Si cambiás de modelo, verificá que responda 200 antes de deployar.
GEMINI_MODEL=gemini-flash-latest
CONFIDENCE_THRESHOLD=0.7
# Notas de voz. VOICE_NOTES_ENABLED=false las apaga sin tocar GEMINI_API_KEY
# (que también se usa para el parseo de texto).
VOICE_NOTES_ENABLED=true
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
# Audio: Gemini (free tier) transcribe primero; OpenAI es el respaldo pago que
# entra solo cuando Gemini falla o da 429. Vacío = voz vuelve a ser Gemini-only.
OPENAI_AUDIO_KEY=
OPENAI_AUDIO_BASE_URL=https://api.openai.com/v1
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe

VOICE_TRANSCRIBE_TIMEOUT_SECONDS=90
VOICE_MAX_BYTES=8388608
VOICE_MAX_SECONDS=120
# Easter egg: roast this member (by name) when they crack a joke. Empty or
# JOKE_ROASTS_ENABLED=false turns it off.
JOKE_TARGET_NAME=Benja
JOKE_ROASTS_ENABLED=true
# FX sources (defaults are fine).
DOLARAPI_URL=https://dolarapi.com
FX_GENERAL_URL=https://open.er-api.com

# --- Gowa (WhatsApp transport) ---
GOWA_IMAGE_TAG=latest
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASS=change-me-strong
# HMAC secret signing inbound webhooks — bot's GOWA_WEBHOOK_SECRET must match
# Gowa's WHATSAPP_WEBHOOK_SECRET (both set from this one value).
GOWA_WEBHOOK_SECRET=change-me-webhook-secret
