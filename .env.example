# gastito — copy to .env and fill in. The same secret must match where noted.

# --- Postgres ---
POSTGRES_USER=gastito
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=gastito

# --- web (spliit) ---
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=USD
# Shared bearer guarding /api/bot/* — must match the bot's BOT_INGEST_SECRET below.
BOT_INGEST_SECRET=change-me-ingest-secret
# Shared login for the web UI (Basic Auth) — one user/pass for the whole group.
# Leave both empty to skip the login prompt (e.g. local dev).
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASS=

# --- bot (LLM: GitHub Models primary, Gemini fallback) ---
GITHUB_MODELS_TOKEN=github_pat_...
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CONFIDENCE_THRESHOLD=0.7
# Easter egg: roast this member (by name) when they crack a joke. Empty or
# JOKE_ROASTS_ENABLED=false turns it off.
JOKE_TARGET_NAME=Benja
JOKE_ROASTS_ENABLED=true
# FX sources (defaults are fine).
DOLARAPI_URL=https://dolarapi.com
FX_GENERAL_URL=https://open.er-api.com

# --- Gowa (WhatsApp transport) ---
GOWA_IMAGE_TAG=latest
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASS=change-me-strong
# HMAC secret signing inbound webhooks — bot's GOWA_WEBHOOK_SECRET must match
# Gowa's WHATSAPP_WEBHOOK_SECRET (both set from this one value).
GOWA_WEBHOOK_SECRET=change-me-webhook-secret
