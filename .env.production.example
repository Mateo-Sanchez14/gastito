# gastito — production env for the msanchez.me droplet.
# Lives at /srv/gastito/.env.production (mode 0600, NOT committed).
# Most secrets are random strings; ANTHROPIC_API_KEY is the only one you must
# bring. DATABASE_URL comes from the deployment-server's DB provisioning.

# --- Caddy routing (wildcard *.msanchez.me already points at the droplet) ---
WEB_HOST=gastito.msanchez.me
GOWA_HOST=gastito-wa.msanchez.me

# --- Shared Postgres (per-project DSN from the deployment-server) ---
DATABASE_URL=postgres://gastito:CHANGE_ME@shared-postgres:5432/gastito

# --- web (spliit) ---
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=USD
BOT_INGEST_SECRET=CHANGE_ME_random_strong
# Shared login for the web UI (Basic Auth) — uno solo para todo el grupo.
# Dejá ambos vacíos para no pedir login. Para cambiarlos: editá y recreá el
# contenedor (`docker compose ... up -d web`), no hace falta rebuild.
WEB_BASIC_AUTH_USER=amigos
WEB_BASIC_AUTH_PASS=CHANGE_ME_shared_password

# --- bot (LLM: GitHub Models primary, Gemini fallback — reused from reserv-ia) ---
# --- bot (LLM: dos slots OpenAI-compatibles en orden, después Gemini) ---
# GitHub Models era el primario; se retiró el 2026-07-30 (su endpoint responde 410).
# Cualquier proveedor con API OpenAI-compatible entra acá sin tocar código: Groq,
# OpenAI, OpenRouter, Cerebras... El slot secundario es opcional: sin token, se saltea.
LLM_PRIMARY_TOKEN=gsk_...
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_SECONDARY_TOKEN=
LLM_SECONDARY_BASE_URL=https://api.openai.com/v1
LLM_SECONDARY_MODEL=gpt-4o-mini
# OBLIGATORIA para las notas de voz 🎙️ (además de ser el fallback del parseo).
# Transcripción Gemini-only: gpt-4o-mini no escucha, no hay respaldo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CONFIDENCE_THRESHOLD=0.7
# Notas de voz. VOICE_NOTES_ENABLED=false las apaga sin tocar GEMINI_API_KEY.
VOICE_NOTES_ENABLED=true
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
# Audio: Gemini (free tier) transcribe primero; OpenAI es el respaldo pago que
# entra solo cuando Gemini falla o da 429. Vacío = voz vuelve a ser Gemini-only.
OPENAI_AUDIO_KEY=
OPENAI_AUDIO_BASE_URL=https://api.openai.com/v1
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe

VOICE_TRANSCRIBE_TIMEOUT_SECONDS=90
VOICE_MAX_BYTES=8388608
VOICE_MAX_SECONDS=120
# Easter egg: roast this member when they joke. Empty / =false disables it.
JOKE_TARGET_NAME=Benja
JOKE_ROASTS_ENABLED=true
DOLARAPI_URL=https://dolarapi.com
FX_GENERAL_URL=https://open.er-api.com

# --- Gowa (WhatsApp transport) ---
GOWA_IMAGE_TAG=latest
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASS=CHANGE_ME_random_strong
GOWA_WEBHOOK_SECRET=CHANGE_ME_random_strong
