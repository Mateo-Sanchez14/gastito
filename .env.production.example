# gastito — production env for the msanchez.me droplet.
# Lives at /srv/gastito/.env.production (mode 0600, NOT committed).
# Most secrets are random strings; ANTHROPIC_API_KEY is the only one you must
# bring. DATABASE_URL comes from the deployment-server's DB provisioning.

# --- Caddy routing (wildcard *.msanchez.me already points at the droplet) ---
WEB_HOST=gastito.msanchez.me
GOWA_HOST=gastito-wa.msanchez.me

# --- Shared Postgres (per-project DSN from the deployment-server) ---
DATABASE_URL=postgres://gastito:CHANGE_ME@shared-postgres:5432/gastito

# --- web (spliit) ---
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=USD
BOT_INGEST_SECRET=CHANGE_ME_random_strong

# --- bot (LLM: GitHub Models primary, Gemini fallback — reused from reserv-ia) ---
GITHUB_MODELS_TOKEN=github_pat_...
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CONFIDENCE_THRESHOLD=0.7
DOLARAPI_URL=https://dolarapi.com
FX_GENERAL_URL=https://open.er-api.com

# --- Gowa (WhatsApp transport) ---
GOWA_IMAGE_TAG=latest
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASS=CHANGE_ME_random_strong
GOWA_WEBHOOK_SECRET=CHANGE_ME_random_strong
