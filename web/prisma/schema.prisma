// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Group {
  id            String              @id
  name          String
  information   String?             @db.Text
  currency      String              @default("$")
  currencyCode  String?
  participants  Participant[]
  expenses      Expense[]
  activities    Activity[]
  whatsappLinks WhatsAppGroupLink[]
  createdAt     DateTime            @default(now())
}

model Participant {
  id              String             @id
  name            String
  // gastito: "presente" — who a default "entre todos" split covers. Deleting a
  // participant is not an option (Expense.paidBy cascades and would take their
  // expenses with them), so someone who leaves the trip is switched off here
  // and keeps every expense and balance they already have.
  active          Boolean            @default(true)
  group           Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId         String
  expensesPaidBy  Expense[]
  expensesPaidFor ExpensePaidFor[]
  whatsappMembers WhatsAppMember[]
  aliases         ParticipantAlias[]
}

model Category {
  id       Int       @id @default(autoincrement())
  grouping String
  name     String
  Expense  Expense[]
}

model Expense {
  id               String            @id
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenseDate      DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  title            String
  category         Category?         @relation(fields: [categoryId], references: [id])
  categoryId       Int               @default(0)
  amount           Int
  originalAmount   Int?
  originalCurrency String?
  conversionRate   Decimal?
  // gastito: provenance of the expense. `source` is "whatsapp" for bot-created
  // expenses (null for manual/UI ones); `externalId` is the Gowa message id.
  // The unique index dedupes Gowa webhook retries (it retries up to 5x).
  source           String?
  externalId       String?
  paidBy           Participant       @relation(fields: [paidById], references: [id], onDelete: Cascade)
  paidById         String
  paidFor          ExpensePaidFor[]
  groupId          String
  isReimbursement  Boolean           @default(false)
  splitMode        SplitMode         @default(EVENLY)
  createdAt        DateTime          @default(now())
  documents        ExpenseDocument[]
  notes            String?

  recurrenceRule         RecurrenceRule?       @default(NONE)
  recurringExpenseLink   RecurringExpenseLink?
  recurringExpenseLinkId String?

  // gastito: WhatsApp message ids (the bot's confirmation messages) that point
  // back at this expense, so a member replying/quoting one can edit it.
  messageRefs      WhatsAppMessageRef[]

  @@unique([source, externalId])
}

model ExpenseDocument {
  id        String   @id
  url       String
  width     Int
  height    Int
  Expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?
}

enum SplitMode {
  EVENLY
  BY_SHARES
  BY_PERCENTAGE
  BY_AMOUNT
}

model RecurringExpenseLink {
  id                    String  @id
  groupId               String
  currentFrameExpense   Expense @relation(fields: [currentFrameExpenseId], references: [id], onDelete: Cascade)
  currentFrameExpenseId String  @unique

  // Note: We do not want to link to the next expense because once it is created, it should be 
  // treated as it's own independent entity. This means that if a user wants to delete an Expense
  // and any prior related recurring expenses, they'll need to delete them one by one.
  nextExpenseCreatedAt DateTime?
  nextExpenseDate      DateTime

  @@index([groupId])
  @@index([groupId, nextExpenseCreatedAt, nextExpenseDate(sort: Desc)])
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model ExpensePaidFor {
  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  expenseId     String
  participantId String
  shares        Int         @default(1)

  @@id([expenseId, participantId])
}

model Activity {
  id            String       @id
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  time          DateTime     @default(now())
  activityType  ActivityType
  participantId String?
  expenseId     String?
  data          String?
}

enum ActivityType {
  UPDATE_GROUP
  CREATE_EXPENSE
  UPDATE_EXPENSE
  DELETE_EXPENSE
}

// gastito: links one WhatsApp group (chatId, "...@g.us") to one spliit Group.
// `fxArsSource` selects which ARS quote the bot uses (oficial | blue | mep).
model WhatsAppGroupLink {
  id          String @id @default(cuid())
  chatId      String @unique
  group       Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  fxArsSource String @default("blue")
  createdAt   DateTime @default(now())
}

// gastito: maps a sender within a WhatsApp group (senderJid) to a spliit
// Participant, so the bot can attribute expenses to the right person.
model WhatsAppMember {
  id            String      @id @default(cuid())
  chatId        String
  senderJid     String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  displayName   String?
  createdAt     DateTime    @default(now())

  @@unique([chatId, senderJid])
}

// gastito: maps a WhatsApp message id (the bot's confirmation message, or any
// message that concerns an expense) to the expense it refers to. When a member
// replies/quotes that message with a correction, the bot resolves the quoted
// `replied_to_id` here to find which expense to edit. (Replying to the member's
// own original message also works via Expense.externalId, checked as a fallback.)
model WhatsAppMessageRef {
  messageId String   @id
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String
  createdAt DateTime @default(now())
}

// gastito: extra nicknames (apodos) that resolve to a Participant, so the bot
// recognizes e.g. "Tuco"/"Tuquina" as "Fer" or "Agustin" as "Pichi". Seeded
// once and extended live via the `/apodo` command. `normalized` is lowercased +
// accent-stripped for lookup; unique per group so one apodo can't map to two
// people.
model ParticipantAlias {
  id            String      @id @default(cuid())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  groupId       String
  alias         String
  normalized    String
  createdAt     DateTime    @default(now())

  @@unique([groupId, normalized])
  @@index([participantId])
}
